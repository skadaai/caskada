{
  "name": "caskada",
  "version": "2.2.0",
  "type": "module",
  "types": "./dist/caskada.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/caskada.d.ts",
        "require": "./dist/caskada.d.cts"
      },
      "import": "./dist/caskada.js",
      "require": "./dist/caskada.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://skada.ai/caskada/",
  "repository": "github:skadaai/caskada",
  "bugs": {
    "url": "https://github.com/skadaai/caskada/issues"
  },
  "description": "Minimalist AI framework in 300 Lines. Enable LLMs to Program Themselves.",
  "keywords": [
    "AI",
    "brainy",
    "Flow",
    "Workflow",
    "LLM"
  ],
  "license": "MPL-2.0",
  "author": {
    "name": "Victor Duarte",
    "url": "https://github.com/zvictor"
  },
  "scripts": {
    "build": "tsup && cp ../README.md ./README.md",
    "prepack": "pnpm run build",
    "test": "NODE_OPTIONS='--experimental-vm-modules --import=tsx node' node --test **/*.test.ts",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@types/node": "24.13.3",
    "p-limit": "7.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public"
  }
}
